{
  "manifest_version": 3,
  "name": "Google Meet Roll Call Extractor",
  "version": "1.0",
  "description": "Extracts user names and roll numbers from Google Meet chat.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_title": "Download Roll Call"
  }
}
